{
  "name": "elsewhere",
  "compatibility_date": "2026-09-07",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "elsewhere",
      "database_id": "local-elsewhere-db",
      "migrations_dir": "migrations"
    }
  ]
}
